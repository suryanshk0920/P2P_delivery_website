{
  "name": "@hosrunner/db",
  "version": "0.0.0",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./generated/client": "./generated/client/index.js"
  },
  "scripts": {
    "db:generate": "prisma generate --schema=./schema.prisma",
    "db:push": "dotenv -e ../../.env -- prisma db push --schema=./schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema=./schema.prisma",
    "db:seed": "dotenv -e ../../.env -- tsx seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2"
  }
}
